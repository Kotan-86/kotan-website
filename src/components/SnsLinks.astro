---
// 仕様: docs/spec/pbi-003-hero-photo-and-sns-links.md#SNSへの導線
//       docs/spec/website.md#ページ構成セクション (ヒーロー・主要SNS 5件)
//
// コントラスト(AC-16): リンクの文字色には --color-text-body(#4f5984)を使う。
// --color-bg-surface(#cfd3e3)に対するコントラスト比は 4.550:1 で、4.5:1 以上を満たす
// （--color-brand-primary をそのまま使うと約 3.353:1 で不合格になるため採用しない。
// 数値は Node.js の WCAG 相対輝度式で算出。両トークンとも既存3トークン、値の変更なし=AC-17）。
// hover/focus でも色は変えず(下線・アウトラインのみ変化)、コントラストは常に 4.550:1 を維持する。
//
// アイコン(AC-13、2026-09-23 改訂・PO 再承認済み。件数は 2026-09-25 に5件へ更新): PO 提供の
// 公式ロゴファイルを src/assets/sns-logos/ に無加工で配置し、img 要素で参照する(SVGの中身を
// .astro に書き写さない。書き写すとロゴ内の16進色が .astro に入り AC-17 に抵触するため)。
// X は白一色の x.svg がページ背景(#cfd3e3, コントラスト1.49:1)でほぼ見えないため、
// 黒の x.webp を採用する(x.svg はリポジトリに追加しない)。GitHub・note・Speaker Desk は
// 公式 SVG、Qiita は公式 SVG が無いため公式 PNG を使う。図形・配色は変更しない(拡大縮小のみ)。
// 5つのロゴは表示上の高さを 16px(Tailwind h-4)に揃える(Qiitaロゴの最小サイズに合わせる)。
// ロゴの alt は "" とし、サービス名はリンクの可視テキスト(<span>)で担保する
// (支援技術から読み取れる名前にサービス名が含まれる。ロゴ代替テキストとの二重読み上げを避ける)。
//
// 並び(AC-11、2026-09-25 更新。切り替え幅は640pxのまま): 揃えるのは5件のグループの左端であり、
// 個々のリンクの左端が揃うことは求めない。幅640px以上では常に5件が横一列、幅639px以下では
// 上段3件・下段2件に固定する。各段は内容幅で左詰めし、段をまたいだ列揃えはしない
// (下段の長い名前に上段の列幅が引きずられない。website.md 第1項)。639px以下では3件目の後に
// 行送り用の空 li を置き、640px以上ではそれを隠して1段にする。
import xLogo from "../assets/sns-logos/x.webp";
import githubLogo from "../assets/sns-logos/github.svg";
import qiitaLogo from "../assets/sns-logos/qiita.png";
import noteLogo from "../assets/sns-logos/note.svg";
import speakerdeckLogo from "../assets/sns-logos/speakerdeck.svg";
import { snsLinks } from "../data/sns-links";
import type { SnsLink } from "../data/sns-links";
import type { ImageMetadata } from "astro";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

// id → ロゴ画像の対応表(5つの id すべてを Record で網羅する)
const logos: Record<SnsLink["id"], ImageMetadata> = {
	x: xLogo,
	github: githubLogo,
	qiita: qiitaLogo,
	note: noteLogo,
	speakerdeck: speakerdeckLogo,
};

// 639px 以下で上段3・下段2に分ける位置(4件目の直前で行送り)
const rowBreakBeforeIndex = 3;
---

<ul
	class:list={["flex flex-wrap items-start gap-x-[30px] gap-y-[1px]", className]}
>
	{
		snsLinks.map((link, index) => (
			<>
				{index === rowBreakBeforeIndex && (
					<li
						class="pointer-events-none h-0 w-full basis-full overflow-hidden sm:hidden"
						aria-hidden="true"
					/>
				)}
				<li>
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 whitespace-nowrap text-base text-text-body outline-offset-2 outline-text-body hover:underline focus-visible:outline focus-visible:outline-2"
					>
						<img
							src={logos[link.id].src}
							width={logos[link.id].width}
							height={logos[link.id].height}
							alt=""
							class="h-4 w-auto shrink-0"
						/>
						<span>{link.name}</span>
					</a>
				</li>
			</>
		))
	}
</ul>
